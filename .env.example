# Copiar a .env.local y completar. Nunca versionar los valores reales.

# Conexión a Neon (Postgres).
DATABASE_URL=postgresql://usuario:password@host.neon.tech/neondb?sslmode=require

# Firma de las sesiones del panel (Auth.js). Generar con `npx auth secret` o `openssl rand -base64 33`.
# En Vercel se define en las variables del proyecto.
AUTH_SECRET=

# Solo al correr `npm run start` fuera de Vercel (en Vercel se detecta solo).
# AUTH_TRUST_HOST=true

# Solo para `npm run db:seed-admin`: la administradora a crear. La contraseña tiene al menos 12
# caracteres (72 bytes como máximo). Mejor pasarlas en el comando que dejarlas en este archivo.
# ADMIN_USUARIO=
# ADMIN_PASSWORD=

# Pago por QR (reservas pendientes de pago). No son secretos. Sin un QR válido la página de la reserva
# dice que el pago por QR no está disponible y NO ofrece el campo del número de operación.
# QR_PAGO_URL es la imagen del QR de la billetera del studio: una URL https:// o una ruta de public/
# (por ejemplo /qr-pago.png). BILLETERA_NOMBRE es opcional ("Yape", "Plin"…).
# QR_PAGO_URL=
# BILLETERA_NOMBRE=
